{
  "name": "footballmanager-io-desktop",
  "version": "0.1.0",
  "description": "Electron desktop wrapper for FootballManager.IO (loads the web app in a native window)",
  "author": "FootballManager.IO",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "build:bundle": "cd .. && node scripts/build-desktop-bundle.mjs",
    "start": "electron .",
    "start:sandbox": "FOOTBALLMANAGER_URL=https://sandbox.footballmanager.io electron .",
    "predist": "npm run build:bundle",
    "predist:mac": "npm run build:bundle",
    "predist:win": "npm run build:bundle",
    "predist:linux": "npm run build:bundle",
    "dist": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "io.footballmanager.desktop",
    "productName": "FootballManager.IO",
    "directories": {
      "output": "../dist-desktop"
    },
    "files": [
      "main.cjs",
      "ota.cjs",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../client/assets/desktop-client.zip",
        "to": "desktop-client.zip"
      }
    ],
    "mac": {
      "category": "public.app-category.sports-games",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
