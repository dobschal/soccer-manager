{
  "name": "soccer-simulation",
  "version": "2026.6.4",
  "description": "",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/api.js",
    "lint": "eslint server ./client --fix",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest run --config client/vitest.config.js",
    "test:server": "vitest run --config server/vitest.config.js",
    "postinstall": "./scripts/copy-vendor.sh",
    "ios": "./scripts/copy-native-client.sh && node ./scripts/build-native-bundle.mjs && cd native-app && ns run ios",
    "android": "./scripts/copy-native-client.sh && node ./scripts/build-native-bundle.mjs && cd native-app && ns run android",
    "emulator:android": "emulator -avd $(emulator -list-avds | head -n 1)",
    "serve:native": "./scripts/copy-native-client.sh && node ./scripts/serve-native-client.mjs",
    "serve:native:local": "./scripts/copy-native-client.sh && NATIVE_SERVER_URL=http://localhost:3000 node ./scripts/serve-native-client.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@parse/node-apn": "^7.1.0",
    "body-parser": "^1.20.2",
    "express": "^4.18.2",
    "firebase-admin": "^13.8.0",
    "geoip-lite": "^1.4.10",
    "jsonwebtoken": "^9.0.1",
    "mysql": "^2.18.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.10.1",
    "tv4": "^1.3.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/dom": "^10.4.1",
    "archiver": "^7.0.1",
    "chart.js": "^4.5.1",
    "es-module-shims": "^2.8.0",
    "eslint": "^9.39.2",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.4.0",
    "jsdom": "^27.4.0",
    "sharp": "^0.34.5",
    "three": "^0.182.0",
    "vitest": "^4.0.18"
  },
  "type": "module"
}
